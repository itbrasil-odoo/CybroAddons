<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="login_as_any_user.ImpersonationBanner" owl="1">
        <div
            t-if="state.isImpersonating"
            class="o_impersonation_banner alert alert-warning mb-0"
            role="alert"
        >
            <i class="fa fa-exclamation-triangle me-2" aria-hidden="true" />
            <span>
                Você está logado como <strong
                    t-out="state.userName"
                /> (impersonado por <t t-out="state.adminName" />)
            </span>
            <button class="btn btn-sm btn-warning ms-2" t-on-click="onSwitchBack">
                <i class="fa fa-sign-out me-1" aria-hidden="true" />
                Voltar para sua conta
            </button>
            <div class="float-end" t-if="state.timeRemaining">
                <i class="fa fa-clock-o me-1" aria-hidden="true" />
                <span>Tempo restante: <t t-out="state.timeRemaining" /></span>
            </div>
        </div>
    </t>
</templates>
