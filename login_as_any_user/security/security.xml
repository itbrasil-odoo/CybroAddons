<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_login_as_any_user" model="ir.module.category">
        <field name="name">Login As Any User</field>
        <field name="description">Helps you manage user switch capabilities</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_login_as_any_user" model="res.groups">
        <field name="name">Allow Login As Any User</field>
        <field name="category_id" ref="module_category_login_as_any_user" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]" />
        <field name="comment">Group for users who can login as other users</field>
    </record>

    <!-- Rule to limit which users can be impersonated -->
    <record id="rule_user_selection_exclusions" model="ir.rule">
        <field name="name">Exclude certain users from being impersonated</field>
        <field name="model_id" ref="model_user_selection" />
        <field name="domain_force">[('user_id.login', 'not in', ['admin'])]</field>
        <field name="groups" eval="[(4, ref('group_login_as_any_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
